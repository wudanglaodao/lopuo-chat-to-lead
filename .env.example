# Database
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public app URL
NEXT_PUBLIC_APP_URL="https://lopuo.work"

# Auth
AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Default customer/site used by seed and local demo
DEFAULT_CUSTOMER_NAME="Lopuo"
DEFAULT_SITE_NAME="Lopuo 官网"
DEFAULT_SITE_DOMAIN="lopuo.work"
DEFAULT_WIDGET_NAME="AI 助理"
DEFAULT_SITE_ID="11111111-1111-4111-8111-111111111111"

# OpenAI-compatible chat generation
# For Xiaomi MiMo, set the base URL from the Xiaomi console and keep the model as needed.
LLM_API_KEY=""
LLM_API_BASE_URL="https://token-plan-cn.xiaomimimo.com/v1"
LLM_MODEL="mimo-v2.5"

# OpenAI-compatible embedding provider
EMBEDDING_API_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-v4"
EMBEDDING_DIMENSIONS="1024"

# Local development only: deterministic fake embeddings when no provider key exists
ALLOW_FAKE_EMBEDDINGS="true"
ALLOW_FAKE_LLM="true"
